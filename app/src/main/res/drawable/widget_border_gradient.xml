<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#76B6FC"
                android:centerColor="#A78BFA"
                android:endColor="#F38A5C" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/widget_card_bg" />
        </shape>
    </item>
</layer-list>