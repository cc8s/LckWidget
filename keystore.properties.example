# 릴리스 APK를 직접 서명해 빌드할 때만 필요합니다.
# 이 파일을 keystore.properties로 복사한 뒤 값을 채우세요. (keystore.properties는 gitignore 대상)
#
# 키스토어 생성 예시:
#   keytool -genkeypair -v -keystore ~/.android-keystores/lckwidget-release.jks \
#     -storetype PKCS12 -alias lckwidget -keyalg RSA -keysize 4096 -validity 10000
#
# 파일이 없으면 릴리스 빌드도 디버그 키로 서명되므로, 클론만 해도 빌드는 됩니다.

storeFile=/absolute/path/to/lckwidget-release.jks
storePassword=
keyAlias=lckwidget
keyPassword=
